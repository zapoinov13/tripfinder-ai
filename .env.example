VITE_SUPABASE_PROJECT_ID=mgyufoyornzbwvgdfojb
VITE_SUPABASE_URL=https://mgyufoyornzbwvgdfojb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public support inbox (App Store / Play)
VITE_SUPPORT_EMAIL=support@tourgo.app

# Server functions (AI keys и т.п.)
SUPABASE_PROJECT_ID=mgyufoyornzbwvgdfojb
SUPABASE_URL=https://mgyufoyornzbwvgdfojb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Vercel: SUPABASE_SERVICE_ROLE_KEY. Lovable Secrets: TOURGO_SERVICE_ROLE_KEY (SUPABASE_ prefix forbidden)
SUPABASE_SERVICE_ROLE_KEY=
TOURGO_SERVICE_ROLE_KEY=

# Mock-оплата Premium для стендов. НЕ включать на проде:
# любой авторизованный получит Premium бесплатно.
PREMIUM_MOCK_CHECKOUT=false

# Аккаунт владельца платформы. В коде он НЕ хранится.
# Прод: создать/обновить в Supabase одной командой (пароль минимум 12 символов):
#   OWNER_EMAIL=... OWNER_PASSWORD=... npm run ensure:admin
# Dev (вход в админку без Supabase, только локальный .env, работает лишь в dev-сборке):
# VITE_DEV_ADMIN_EMAIL=
# VITE_DEV_ADMIN_PASSWORD=
